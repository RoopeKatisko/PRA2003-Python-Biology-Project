import matplotlib.pyplot as plt
import numpy as np
import pandas as pd
import math
data = []

#Input file path so that the code works for other users aswell
file_path = "output-Set0.txt"

#Importing and printing the raw data from the external text file
with open(file_path, "r") as datafile:
    for line in datafile:
        operators = line.split()
        print("Initial data", operators)

#Adding and separating the values in the "data" list and through that into a pandas dataframe
with open(file_path,"r") as datafile:
    for line in datafile:
        operators = line.split()

        if len(operators) != 4: #Skips the header ( 1 29 ) which caused problems as it had 2 values instead of 4
            continue

        px, py, pz, particle_id = operators

        data.append([
            float(px),
            float(py),
            float(pz),
            int(particle_id)
        ])

dataframe = pd.DataFrame(data, columns=["px", "py", "pz", "id"])
#Self explanatory
print(dataframe)
#Total momentum function using Numpy sqrt functions and pandas dataframe appends
dataframe["p"] = np.sqrt( 
    dataframe["px"]**2 + 
    dataframe["py"]**2 + 
    dataframe["pz"]**2 
)
#Test
print(dataframe)